# ════════════════════════════════════════════════════════════════════════════
# AICC — AI Command Center | Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# Generate random secrets with: openssl rand -hex 64
# ════════════════════════════════════════════════════════════════════════════

# ── CORE ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Used by FastAPI sessions and Supabase realtime
SECRET_KEY_BASE=REPLACE_WITH_openssl_rand_hex_64

# ── POSTGRES / SUPABASE ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=REPLACE_WITH_strong_password
# Used to sign JWTs for Supabase auth and PostgREST
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_64

# Supabase local dev URL (Docker internal)
SUPABASE_URL=http://localhost:8000
# Generated by Supabase — get from Studio > Settings > API
SUPABASE_ANON_KEY=REPLACE_WITH_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_supabase_service_role_key

# External URL used by GoTrue auth redirects
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3001

# ── SMTP (for Supabase auth confirmation emails) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Use a Gmail App Password (not your main password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_USER=caresir.gonzales@kw.com
SMTP_PASS=REPLACE_WITH_gmail_app_password
SMTP_ADMIN_EMAIL=caresir.gonzales@kw.com

# ── N8N WORKFLOW AUTOMATION ──────────────────────────────────────────────────
N8N_HOST=localhost
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32
N8N_WEBHOOK_URL=http://localhost:5678

# ── ANTHROPIC (AI Engine) ────────────────────────────────────────────────────
# Default model: claude-sonnet-4-6
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_your_key

# ── GOOGLE WORKSPACE ─────────────────────────────────────────────────────────
# OAuth2 credentials from Google Cloud Console
# Scopes needed: Gmail, Calendar, Drive, Photos
GOOGLE_CLIENT_ID=REPLACE_WITH_google_client_id
GOOGLE_CLIENT_SECRET=REPLACE_WITH_google_client_secret
GOOGLE_REFRESH_TOKEN=REPLACE_WITH_google_refresh_token
# Primary Google Calendar ID (usually your email address)
GOOGLE_CALENDAR_ID=caresir.gonzales@kw.com
# Google Drive folder where AICC stores documents
GOOGLE_DRIVE_FOLDER_ID=REPLACE_WITH_drive_folder_id

# ── KELLER WILLIAMS / KW COMMAND ─────────────────────────────────────────────
KW_COMMAND_API_KEY=REPLACE_WITH_kw_command_api_key
KW_AGENT_ID=REPLACE_WITH_kw_agent_id

# ── HAR MLS ──────────────────────────────────────────────────────────────────
HAR_MLS_API_KEY=REPLACE_WITH_har_mls_api_key
HAR_MLS_USERNAME=REPLACE_WITH_har_mls_username

# ── LONE WOLF TRANSACTIONS (Phase 3 — read-only status sync first) ───────────
# All transaction documents are managed in Lone Wolf Transactions.
# AI drafts agreements for Jennifer's review only — never executes directly.
# API docs: https://docs.lwolf.com
LONE_WOLF_API_KEY=REPLACE_WITH_lone_wolf_api_key
LONE_WOLF_ACCOUNT_ID=REPLACE_WITH_lone_wolf_account_id

# ── INSTAGRAM ────────────────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=REPLACE_WITH_instagram_long_lived_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=REPLACE_WITH_instagram_business_id

# ── TIKTOK ───────────────────────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=REPLACE_WITH_tiktok_access_token
TIKTOK_CLIENT_KEY=REPLACE_WITH_tiktok_client_key
TIKTOK_CLIENT_SECRET=REPLACE_WITH_tiktok_client_secret

# ── YOUTUBE ──────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=REPLACE_WITH_youtube_data_api_v3_key
YOUTUBE_CHANNEL_ID=REPLACE_WITH_youtube_channel_id

# ── FACEBOOK ─────────────────────────────────────────────────────────────────
FACEBOOK_PAGE_ACCESS_TOKEN=REPLACE_WITH_facebook_page_access_token
FACEBOOK_PAGE_ID=REPLACE_WITH_facebook_page_id

# ── AMAZON FBA (scholarshipee.com) ───────────────────────────────────────────
AMAZON_SP_API_CLIENT_ID=REPLACE_WITH_sp_api_client_id
AMAZON_SP_API_CLIENT_SECRET=REPLACE_WITH_sp_api_client_secret
AMAZON_SP_API_REFRESH_TOKEN=REPLACE_WITH_sp_api_refresh_token
AMAZON_SELLER_ID=REPLACE_WITH_amazon_seller_id
# US marketplace
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# ── TWILIO (SMS notifications + client messages) ──────────────────────────────
TWILIO_ACCOUNT_SID=REPLACE_WITH_twilio_account_sid
TWILIO_AUTH_TOKEN=REPLACE_WITH_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Your personal cell — CEO briefings and alerts are sent here
KAREESA_PHONE=+1XXXXXXXXXX

# ── STRIPE (AI Agency client payments) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_stripe_webhook_secret

# ── CALENDLY (GymnastDiva private lessons) ────────────────────────────────────
CALENDLY_API_KEY=REPLACE_WITH_calendly_personal_access_token
CALENDLY_USER_URI=https://api.calendly.com/users/REPLACE_WITH_user_id

# ── BRAND CONSTANTS ───────────────────────────────────────────────────────────
BRAND_NAME=Locked In with Kareesa
BRAND_HANDLE=@LockedInWithKareesa
BRAND_EMAIL=caresir.gonzales@kw.com
AGENT_NAME=Kareesa Gonzales
AGENT_LICENSE_STATE=TX
BROKERAGE=Keller Williams Preferred
BROKER_COACH=Jennifer
SPONSOR_AGENT=Kimberly Spiller
TIMEZONE=America/Chicago
