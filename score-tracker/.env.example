# SCORE Tracker — env vars

# ── Used by log_activity.py (Python CLI) ─────────────────────────────────────
# Same Supabase Cloud project the rest of AICC actually runs on (see root
# .env — SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY). Legacy JWT-format key
# required, not the newer sb_secret_/sb_publishable_ format — supabase-py 2.x
# needs the JWT format.
SUPABASE_URL=https://REPLACE_WITH_your_project_ref.supabase.co
SUPABASE_KEY=REPLACE_WITH_supabase_service_role_key

# ── Used by the n8n workflows ─────────────────────────────────────────────────
# These must be set in docker-compose.yml's n8n service `environment:` block
# (not here) — n8n reads them via $env.VAR_NAME in node expressions. This
# file just documents what's needed; see score-tracker/README.md.
#
# SUPABASE_URL             — same cloud project as above
# SUPABASE_SERVICE_ROLE_KEY — same key as above (note: different var name
#                              than the Python script's SUPABASE_KEY, matches
#                              root .env's existing naming)
# MY_CELL                  — your personal cell, SMS destination for nudges/reports
# MY_EMAIL                 — your email, destination for the Friday report card
# TWILIO_PHONE_NUMBER      — reused from root .env (AICC's existing Twilio number)
# ANTHROPIC_API_KEY        — reused from root .env
#
# Twilio and Gmail themselves are NOT env vars for n8n — they're native n8n
# credentials ("Twilio account" / "Gmail account") set up in the n8n UI.
