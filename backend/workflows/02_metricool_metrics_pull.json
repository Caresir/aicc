{
  "name": "Metricool — Daily Metrics Pull",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 12 * * *"
            }
          ]
        }
      },
      "id": "f2a3b4c5-0002-0002-0002-000000000001",
      "name": "Daily 6am CT (noon UTC)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Build date range: last 30 days\nconst today = new Date();\nconst from  = new Date(today - 30 * 86400000);\nconst fmt = d => d.toISOString().slice(0, 10);\nreturn [{ json: { fromDate: fmt(from), toDate: fmt(today) } }];"
      },
      "id": "f2a3b4c5-0002-0002-0002-000000000002",
      "name": "Build Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://app.metricool.com/api/smart/v1/analytics/posts?userId={{ $env.METRICOOL_USER_ID }}&blogId={{ $env.METRICOOL_BLOG_ID }}&fromDate={{ $json.fromDate }}&toDate={{ $json.toDate }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Mc-Auth", "value": "={{ $env.METRICOOL_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "f2a3b4c5-0002-0002-0002-000000000003",
      "name": "Fetch Metricool Analytics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://rest:3000/video_tracker?caption_status=eq.posted",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "f2a3b4c5-0002-0002-0002-000000000004",
      "name": "Get Posted Videos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [680, 480]
    },
    {
      "parameters": {
        "jsCode": "// Match Metricool post stats back to video_tracker rows\nconst metricoolPosts = $('Fetch Metricool Analytics').first().json;\nconst dbVideos       = $('Get Posted Videos').first().json;\n\nconst posts = Array.isArray(metricoolPosts) ? metricoolPosts\n            : (metricoolPosts.posts || []);\nconst videos = Array.isArray(dbVideos) ? dbVideos : [];\n\nconst updates = [];\n\nfor (const post of posts) {\n  const network  = (post.network || '').toLowerCase();\n  const text     = (post.message || post.text || '').toLowerCase();\n  const stats    = post.stats || post.analytics || {};\n\n  const match = videos.find(v =>\n    text.includes((v.title || '').toLowerCase()) ||\n    text.includes((v.neighborhood || '').toLowerCase())\n  );\n  if (!match) continue;\n\n  const payload = { id: match.id };\n  if (network === 'instagram') {\n    payload.ig_likes    = stats.likes    || 0;\n    payload.ig_comments = stats.comments || 0;\n    payload.ig_saves    = stats.saves    || 0;\n    payload.ig_shares   = stats.shares   || 0;\n  } else if (network === 'tiktok') {\n    payload.tiktok_views = stats.views || stats.plays || 0;\n    payload.tiktok_likes = stats.likes || 0;\n  }\n\n  if (Object.keys(payload).length > 1) updates.push({ json: payload });\n}\n\nreturn updates.length ? updates : [{ json: { id: null, _skip: true } }];"
      },
      "id": "f2a3b4c5-0002-0002-0002-000000000005",
      "name": "Match & Map Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 380]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json._skip }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "notEquals" }
            }
          ]
        }
      },
      "id": "f2a3b4c5-0002-0002-0002-000000000006",
      "name": "Has Updates?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 380]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=http://rest:3000/video_tracker?id=eq.{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ig_likes: $json.ig_likes, ig_comments: $json.ig_comments, ig_saves: $json.ig_saves, ig_shares: $json.ig_shares, tiktok_views: $json.tiktok_views, tiktok_likes: $json.tiktok_likes }) }}",
        "options": {}
      },
      "id": "f2a3b4c5-0002-0002-0002-000000000007",
      "name": "Update Supabase Metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1340, 300]
    }
  ],
  "connections": {
